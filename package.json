{
  "name": "iiif-volumetric-server",
  "version": "0.1.0",
  "description": "Proof-of-concept IIIF server for NIfTI and other volumetric formats, using the IIIF Presentation 4.0 alpha (draft 3D) spec and IIIF Image API 3.0 for 2D slice tiles.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "make-fixture": "node scripts/make-synthetic-nifti.js",
    "test": "node --test test/server.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "cors": "^2.8.5",
    "nifti-reader-js": "^0.6.8",
    "nrrd-js": "^0.2.1",
    "pngjs": "^7.0.0",
    "pako": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
